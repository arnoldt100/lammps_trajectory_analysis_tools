{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "md_params.schema.json",
  "title": "MD Simulation Parameters",
  "type": "object",
  "required": ["time","ensemble","pressure"],
  "properties": {
    "time": {
      "type": "object",
      "required": ["units", "time_step","total_number_steps"],
      "properties": {
        "units": {
          "type": "string",
          "description": "Time units used in the MD simulation, e.g. fs, ps, ns"
        },
        "time_step": {
          "type": "number",
          "description": "MD time step value"
        },
        "total_number_steps": {
          "type": "number",
          "description": "Total number of steps."
        }
      },
      "additionalProperties": true
    },
    "ensemble": {
      "type" : "string",
      "description" : "The simulation ensemble"
    },
    "pressure": {
      "type": "number",
      "description": "The pressure of the ensemble"
    }
  },
  "additionalProperties": true
}
