{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "md_params.schema.json",
  "title": "MD Simulation Parameters Schema",
  "type": "object",
  "properties": {
      "simulation_parameters": {
          "type": "object",
          "description": "Simulation parameters for the MD simulation",
          "properties": {
              "time": {
                  "type": "object",
                  "description": "Time-related parameters for the simulation",
                  "required": ["units", "time_step", "total_steps"],
                  "properties": {
                      "units": {
                          "type": "string",
                          "description": "Units of time for the simulation"
                      },
                      "time_step": {
                          "type": "number",
                          "description": "Time step for the simulation"
                      },
                      "total_steps": {
                          "type": "number",
                          "description": "Total number of steps for the simulation"
                      }
                  }
              },
              "ensemble": {
                  "type": "string",
                  "description": "Ensemble type for the simulation"
              },
              "temperature": {
                  "type": "number",
                  "description": "Temperature for the simulation"
              },
              "pressure": {
                  "type": "number",
                  "description": "Pressure for the simulation"
              }
          },
          "required": ["time", "ensemble", "temperature", "pressure"] 
      }
  },
  "required": ["simulation_parameters"]
}
