{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "md_metadata.schema.json",
  "title": "Generated MD Metadata",
  "description" : "A MD simulation metadata - software build parameters, programming environment, etc.",
  "type": "object",
  "properties": {
      "simulation_metadata" : {
          "description": "The simulation metadata",
          "type" : "object",
          "properties": {
              "software_description": {
                  "type" : "object",
                  "description": "The software name and version",
                  "properties": {
                      "extras": {
                          "description" : "Extra software information",
                          "type" : "array",
                          "items" : {"type": "string"}
                      },
                      "name": {
                          "description": "The software name",
                          "type": "string"
                      },
                      "version": {
                          "description": "The software version",
                          "type": "string"
                      }
                  },
                  "required" : ["name","version"]
              },
              "build_description": {
                  "description": "The software build programming environment",
                  "type" : "object",
                  "properties": {
                      "extras": {
                          "description" : "Extra build information",
                          "type": "array",
                          "items": {"type": "string"}
                      },
                      "compiling machine": {
                          "description" : "The computer the program was compiled on.",
                          "type": "string"
                      },
                      "programming environment": {
                          "description" : "The programming environment the software was built with",
                          "type": "array",
                          "items": {"type": "string"}
                      }
                  },
                  "required": ["compiling machine","programming environment"]
              }
          },
          "required" : ["software_description","build_description"]
      }
  },
  "required": ["simulation_metadata"]
}
