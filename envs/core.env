#! /usr/bin/env bash
unset PYTHON_GIL

# Modify the PYTHONPATH
export PYTHONPATH="${LTAT_TOP_LEVEL}/src:${LTAT_TOP_LEVEL}/tests:${PYTHONPATH}"

# Modify the PATH variable to include the top level scripts.
export PATH="${LTAT_TOP_LEVEL}/src/bin:${PATH}"

# The command 'uv run' can locate the Python virtual environment if the
# environmental variable 'UV_PROJECT_ENVIRONMENT' is set to 'LTAT_PYTHON_VENV'.
export UV_PROJECT_ENVIRONMENT="${LTAT_PYTHON_VENV}"

# Plots only the first N frames for debugging.
# A non-positive integer value means plot all frames.
export LTAT_DEBUG_PLOT_FRAMES='-1'
